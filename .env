# Server Configuration
PORT=3000
NODE_ENV=development

# SendPulse SMTP Configuration
SMTP_HOST=smtp-pulse.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sendpulse_email@example.com
SMTP_PASSWORD=your_sendpulse_password

# Email Configuration
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Your Service Name

# API Security
API_KEYS=your_secret_api_key_1,your_secret_api_key_2,your_secret_api_key_3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Application URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
